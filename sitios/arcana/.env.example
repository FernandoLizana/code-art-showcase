# Database
DATABASE_URL="file:./dev.db"

# Session & Security
SESSION_SECRET="change-this-to-a-random-64-char-string-in-production"
ADMIN_PASSWORD_HASH=""

# Game Configuration
GAME_NAME="ARCANA OBSCURA"
NODE_ENV="development"

# Final Level (public or fictional location only)
FINAL_SAFE_COORDINATES="0.0,0.0"
FINAL_DESTINATION_LABEL="Lugar ficticio — configurar antes del despliegue"

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=60000

# Development
DEV_MODE=false
SKIP_PERSONALITY=false
